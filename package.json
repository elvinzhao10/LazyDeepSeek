{
  "name": "lazydeepseek",
  "version": "1.4.1",
  "description": "LazyDeepSeek — the DeepSeek Harness (dsh) member of the LazySeries family: skills, hooks, MCP servers, commands, agents and the Ralph/ULW loop ported from LazyZCode.",
  "license": "MIT",
  "main": "lib/index.mjs",
  "files": [
    "lib/",
    "cordis.patch.yml",
    "plugins/",
    "!**/node_modules/**",
    "docs/",
    "README.md",
    "NOTICE",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "agent-skills",
    "hooks",
    "mcp",
    "lazyseries"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh": "0.2.1-rc.5",
    "@deepseek-ai/dsh-mcp-client": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tool-jobs": "0.2.1-rc.5",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.1-rc.5",
    "@deepseek-ai/dsh-agent-preset": "0.2.1-rc.5",
    "@deepseek-ai/dsh-persona": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tool-fs": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tool-bash": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tool-web": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tool-todo": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tool-subagent": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tool-ralph": "0.2.1-rc.5",
    "@deepseek-ai/dsh-workflow-ptc": "0.2.1-rc.5"
  },
  "engines": {
    "dsh": "0.2.1-rc.5"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.2.1-rc.5",
    "@deepseek-ai/dsh-mcp-client": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tool-jobs": "0.2.1-rc.5",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.1-rc.5",
    "@deepseek-ai/dsh-agent-preset": "0.2.1-rc.5",
    "@deepseek-ai/dsh-persona": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tool-fs": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tool-bash": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tool-web": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tool-todo": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tool-subagent": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tool-ralph": "0.2.1-rc.5",
    "@deepseek-ai/dsh-workflow-ptc": "0.2.1-rc.5"
  },
  "dependencies": {
    "@deepseek-ai/dsh-hooks-claude-code": "0.2.1-rc.5",
    "@deepseek-ai/dsh-hook-protocol": "0.2.1-rc.5"
  },
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client.js",
    "./lib/*": "./lib/*",
    "./package.json": "./package.json"
  }
}
