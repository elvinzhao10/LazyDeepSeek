{
  "_lazydeepseek_template": "Template only. Seven supported installed bridge events; PermissionRequest and PostToolUseFailure remain synthesized/degraded. Live generated files use profile and package content identity under $DSH_HOME/lazydeepseek/runtimes/<identity>/hooks.dsh.json.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "LAZYDEEPSEEK_PLUGIN_ROOT='<LAZYDEEPSEEK_PACKAGE_ROOT>' LAZYDEEPSEEK_PROJECT_DIR=\"${CLAUDE_PROJECT_DIR}\" bash '<LAZYDEEPSEEK_PACKAGE_ROOT>/plugins/lazydeepseek/scripts/hooks/session-start.sh'"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "LAZYDEEPSEEK_PLUGIN_ROOT='<LAZYDEEPSEEK_PACKAGE_ROOT>' LAZYDEEPSEEK_PROJECT_DIR=\"${CLAUDE_PROJECT_DIR}\" bash '<LAZYDEEPSEEK_PACKAGE_ROOT>/plugins/lazydeepseek/scripts/hooks/user-prompt-submit.sh'"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "write|edit|bash",
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "LAZYDEEPSEEK_PLUGIN_ROOT='<LAZYDEEPSEEK_PACKAGE_ROOT>' LAZYDEEPSEEK_PROJECT_DIR=\"${CLAUDE_PROJECT_DIR}\" bash '<LAZYDEEPSEEK_PACKAGE_ROOT>/plugins/lazydeepseek/scripts/hooks/pre-tool-use.sh'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "LAZYDEEPSEEK_PLUGIN_ROOT='<LAZYDEEPSEEK_PACKAGE_ROOT>' LAZYDEEPSEEK_PROJECT_DIR=\"${CLAUDE_PROJECT_DIR}\" bash '<LAZYDEEPSEEK_PACKAGE_ROOT>/plugins/lazydeepseek/scripts/hooks/post-tool-use.sh'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "LAZYDEEPSEEK_PLUGIN_ROOT='<LAZYDEEPSEEK_PACKAGE_ROOT>' LAZYDEEPSEEK_PROJECT_DIR=\"${CLAUDE_PROJECT_DIR}\" bash '<LAZYDEEPSEEK_PACKAGE_ROOT>/plugins/lazydeepseek/scripts/hooks/stop-gate.sh'"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node '<LAZYDEEPSEEK_PACKAGE_ROOT>/plugins/lazydeepseek/scripts/native-subagent-event.js'",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node '<LAZYDEEPSEEK_PACKAGE_ROOT>/plugins/lazydeepseek/scripts/native-subagent-event.js'",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
